-- ============================================================
-- SEQUENCES
-- ============================================================
CREATE SEQUENCE seq_users        START WITH 1 INCREMENT BY 1 NOCACHE NOCYCLE;
CREATE SEQUENCE seq_wallets      START WITH 1 INCREMENT BY 1 NOCACHE NOCYCLE;
CREATE SEQUENCE seq_transactions START WITH 1 INCREMENT BY 1 NOCACHE NOCYCLE;
CREATE SEQUENCE seq_requests     START WITH 1 INCREMENT BY 1 NOCACHE NOCYCLE;

-- ============================================================
-- TABLES
-- ============================================================
CREATE TABLE Users (
    UserID        NUMBER         NOT NULL,
    UserName      VARCHAR2(100)  NOT NULL UNIQUE,
    PasswordHash  VARCHAR2(256)  NOT NULL,
    PIN           VARCHAR2(10)   NOT NULL,
    PhoneNumber   VARCHAR2(20)   NOT NULL UNIQUE,
    IsLocked      NUMBER(1)      DEFAULT 0 NOT NULL,
    CreatedAt     TIMESTAMP      DEFAULT SYSTIMESTAMP NOT NULL,
    CONSTRAINT pk_users     PRIMARY KEY (UserID),
    CONSTRAINT chk_islocked CHECK (IsLocked IN (0, 1))
);

CREATE TABLE Wallets (
    WalletID     NUMBER         NOT NULL,
    UserID       NUMBER         NOT NULL,
    Balance      NUMBER(15, 2)  DEFAULT 0.00 NOT NULL,
    BankName     VARCHAR2(100)  NOT NULL,
    CardNumber   VARCHAR2(20)   NOT NULL UNIQUE,
    CreatedAt    TIMESTAMP      DEFAULT SYSTIMESTAMP NOT NULL,
    CONSTRAINT pk_wallets     PRIMARY KEY (WalletID),
    CONSTRAINT fk_wallet_user FOREIGN KEY (UserID) REFERENCES Users(UserID) ON DELETE CASCADE,
    CONSTRAINT chk_balance    CHECK (Balance >= 0)
);

CREATE TABLE Transactions (
    TransactionID    NUMBER         NOT NULL,
    SenderWalletID   NUMBER         NOT NULL,
    ReceiverWalletID NUMBER         NOT NULL,
    Amount           NUMBER(15, 2)  NOT NULL,
    TransactionType  VARCHAR2(50)   NOT NULL,
    TransactionDate  TIMESTAMP      DEFAULT SYSTIMESTAMP NOT NULL,
    Status           VARCHAR2(20)   DEFAULT 'Pending' NOT NULL,
    CONSTRAINT pk_transactions PRIMARY KEY (TransactionID),
    CONSTRAINT fk_txn_sender   FOREIGN KEY (SenderWalletID)   REFERENCES Wallets(WalletID),
    CONSTRAINT fk_txn_receiver FOREIGN KEY (ReceiverWalletID) REFERENCES Wallets(WalletID),
    CONSTRAINT chk_txn_amount  CHECK (Amount > 0),
    CONSTRAINT chk_txn_status  CHECK (Status IN ('Pending','Completed','Failed','Reversed')),
    CONSTRAINT chk_txn_type    CHECK (TransactionType IN ('Transfer','Deposit','Withdrawal','Request Payment'))
);

CREATE TABLE Requests (
    RequestID      NUMBER         NOT NULL,
    SenderUserID   NUMBER         NOT NULL,
    ReceiverUserID NUMBER         NOT NULL,
    Amount         NUMBER(15, 2)  NOT NULL,
    RequestDate    TIMESTAMP      DEFAULT SYSTIMESTAMP NOT NULL,
    Status         VARCHAR2(20)   DEFAULT 'Pending' NOT NULL,
    Note           VARCHAR2(500),
    CONSTRAINT pk_requests     PRIMARY KEY (RequestID),
    CONSTRAINT fk_req_sender   FOREIGN KEY (SenderUserID)   REFERENCES Users(UserID),
    CONSTRAINT fk_req_receiver FOREIGN KEY (ReceiverUserID) REFERENCES Users(UserID),
    CONSTRAINT chk_req_amount  CHECK (Amount > 0),
    CONSTRAINT chk_req_status  CHECK (Status IN ('Pending','Accepted','Rejected','Cancelled'))
);


CREATE OR REPLACE TRIGGER trg_users_id
BEFORE INSERT ON Users FOR EACH ROW
BEGIN
    :NEW.UserID := seq_users.NEXTVAL;
END;
/

CREATE OR REPLACE TRIGGER trg_wallets_id
BEFORE INSERT ON Wallets FOR EACH ROW
BEGIN
    :NEW.WalletID := seq_wallets.NEXTVAL;
END;
/

CREATE OR REPLACE TRIGGER trg_transactions_id
BEFORE INSERT ON Transactions FOR EACH ROW
BEGIN
    :NEW.TransactionID := seq_transactions.NEXTVAL;
END;
/

CREATE OR REPLACE TRIGGER trg_requests_id
BEFORE INSERT ON Requests FOR EACH ROW
BEGIN
    :NEW.RequestID := seq_requests.NEXTVAL;
END;
/

CREATE INDEX idx_wallet_userid ON Wallets(UserID);
CREATE INDEX idx_txn_sender    ON Transactions(SenderWalletID);
CREATE INDEX idx_txn_receiver  ON Transactions(ReceiverWalletID);
CREATE INDEX idx_txn_date      ON Transactions(TransactionDate);
CREATE INDEX idx_req_sender    ON Requests(SenderUserID);
CREATE INDEX idx_req_receiver  ON Requests(ReceiverUserID);
CREATE INDEX idx_req_status    ON Requests(Status);

COMMIT;

